{
	"schemaVersion": 1,
	"id": "zk-nomosiki-items",
	"version": "${version}",
	"name": "ZK Nomosiki Items",
	"description": "Japanese RP armor and weapons for Nomosiki. Stats and recipes inspired by Samurai Dynasty (LGPL); 3D assets included with permission from VeroxUniverse.",
	"authors": [
		"WorldofCraft9"
	],
	"contributors": [
		"VeroxUniverse (Samurai Dynasty stats/recipes, LGPL-3.0)",
		"ewewukek (Musket Mod combat logic and sounds, MIT)",
		"Scarecrow01 aka Flintl0ck (flintlock models)"
	],
	"license": "LGPL-3.0-only",
	"icon": "assets/zk-nomosiki-items/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.nomosiki.work.NomosikiWork"
		],
		"client": [
			"com.nomosiki.work.client.NomosikiWorkClient"
		]
	},
	"mixins": [
		"zk-nomosiki-items.mixins.json",
		{
			"config": "zk-nomosiki-items.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"azurelib": "*"
	}
}
